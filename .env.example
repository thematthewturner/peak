# Placeholders only. Production config goes in /etc/peak/peak.env (chmod 600).
PEAK_ENV=production
PEAK_DEMO=0
APP_BASE_URL=https://peak.mturner.work
APP_TIMEZONE=America/New_York
POSTGRES_DB=peak
POSTGRES_USER=peak
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_SECRET
DATABASE_URL=postgresql+psycopg://peak:REPLACE_WITH_URL_ENCODED_SECRET@postgres:5432/peak
DATA_DIR=/data
# Address of the shared edge proxy on the external `edge` network (only it may assert client identity).
EDGE_PROXY_IP=REPLACE_WITH_EDGE_PROXY_IP
# Models. MODEL_ID drafts and extracts; MODEL_CHECK_ID blind-solves (a different model avoids shared blind spots).
MODEL_ID=claude-sonnet-5-5
# MODEL_CHECK_ID=claude-opus-5-5
# Monthly spend caps in USD, enforced before every provider call. Ingestion has its own cap.
PEAK_COST_LIMIT_MONTH=20
INGEST_COST_LIMIT=200
# PEAK_REQUEST_LIMIT_MONTH=2000
# PEAK_TOKEN_LIMIT_MONTH=20000000
MAX_UPLOAD_BYTES=33554432
# Set immutable images after CI builds.
WEB_IMAGE=ghcr.io/thematthewturner/peak-web:REPLACE_WITH_COMMIT_SHA
BACKEND_IMAGE=ghcr.io/thematthewturner/peak-backend:REPLACE_WITH_COMMIT_SHA
# Peak's OWN Claude API key, separate from Belay's. Server-side only, mounted in api and worker.
# ANTHROPIC_API_KEY_FILE=/run/secrets/anthropic_key
# ANTHROPIC_API_KEY=
